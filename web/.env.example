# ============================================================
# VEXIM OPS — biến môi trường ứng dụng web
# Sao chép thành .env.local khi vận hành. KHÔNG commit .env.local
# Khi chưa có gì: ứng dụng chạy ở DEMO MODE (MockProvider) —
# đúng kiến trúc adapter Mock → Sandbox → Production.
# ============================================================

# --- Supabase (điền khi VEXIM tạo project — xem supabase/README.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dành cho worker đồng bộ chạy server-side. TUYỆT ĐỐI không expose ra client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Amazon SP-API (điền khi được duyệt Developer Profile) ---
# SPAPI_LWA_CLIENT_ID=
# SPAPI_LWA_CLIENT_SECRET=
# SPAPI_REDIRECT_URI=https://ops.vexim.vn/api/amazon/callback
