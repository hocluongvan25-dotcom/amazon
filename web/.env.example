# ============================================================
# VEXIM OPS — biến môi trường ứng dụng web
# Sao chép thành .env.local khi vận hành. KHÔNG commit .env.local
# Khi chưa có gì: ứng dụng chạy ở DEMO MODE (MockProvider) —
# đúng kiến trúc adapter Mock → Sandbox → Production.
# ============================================================

# --- Site URL (QUAN TRỌNG cho invite) ---
# Origin thật của production, dùng để tạo redirect_to cho email mời:
#   redirect_to = <SITE_URL>/invite
# Nếu để trống, hệ thống sẽ thử VERCEL_PROJECT_PRODUCTION_URL rồi origin của request,
# nhưng tốt nhất đặt cố định để tránh localhost:3000 lọt vào email production.
# Production chính thức: https://veximops.com  (KHÔNG có trailing slash)
NEXT_PUBLIC_SITE_URL=https://veximops.com

# --- Supabase (điền khi VEXIM tạo project — xem supabase/README.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dành cho worker/cron chạy server-side (KHÔNG expose ra client).
# Cần cho: đồng bộ SP-API/Ads, sinh `state` OAuth và lưu refresh token.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (Vercel Cron gọi /api/cron/*; phải khớp Bearer <CRON_SECRET>) ---
CRON_SECRET=

# --- Amazon SP-API (app production đã được Amazon duyệt) ---
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_SP_API_REGION=NA

# Module 0 — luồng "Kết nối shop" (authorize lại khi token hết hạn 365 ngày):
#   AMAZON_SP_API_APP_ID         = application id của app SP-API (amzn1.sp.solution.…)
#   AMAZON_SP_API_REDIRECT_URI   = phải TRÙNG ĐÚNG từng ký tự với redirect URI đã
#                                  đăng ký ở Amazon, nếu không Amazon trả invalid_grant
AMAZON_SP_API_APP_ID=
#                                  Production chính thức: https://veximops.com/api/oauth/amazon/callback
AMAZON_SP_API_REDIRECT_URI=https://veximops.com/api/oauth/amazon/callback
# (optional) Danh sách Allowed Return URLs y hệt trong Developer Console
# (phân tách bằng dấu phẩy) — để /api/oauth/amazon/diag đối soát tự động.
AMAZON_LWA_ALLOWED_RETURN_URLS=https://veximops.com/api/oauth/amazon/callback

# --- Amazon ADS (ĐĂNG KÝ RIÊNG, KHÔNG dùng chung app SP-API) ---
# Ads có LWA client/secret/refresh token riêng. Thiếu 3 biến này thì job ads trả
# `skipped` kèm hướng dẫn (không làm đỏ dashboard), và màn /ppc hiện hướng dẫn nạp.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
# NA (advertising-api.amazon.com) · EU (advertising-api-eu…) · FE (advertising-api-fe…)
# Để trống thì lấy theo AMAZON_SP_API_REGION, mặc định NA.
AMAZON_ADS_REGION=NA
