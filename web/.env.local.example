# ============================================================
# File .env.local MẪU — copy thành .env.local và điền giá trị thật.
# KHÔNG commit file .env.local (đã có trong .gitignore).
# File .env.local.example chỉ chứa placeholder, không có secret thật.
# ============================================================

# Supabase — project ref: pitmyzovjwflkyoqjbkz
NEXT_PUBLIC_SUPABASE_URL=https://pitmyzovjwflkyoqjbkz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ dùng server-side (cron jobs, admin actions), không bao giờ lộ ra client:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Amazon SP-API (lấy từ Seller Central → Partner Network → Developer Central
# → ứng dụng VEXIM Ops → self-authorize cho seller ID của VEXIM)
# LƯU Ý BẢO MẬT: LWA_CLIENT_SECRET và LWA_REFRESH_TOKEN là bí mật — KHÔNG commit,
# không chia sẻ qua chat/email, sau khi hoàn thành testing production cần ROTATE.
AMAZON_APP_ID=amzn1.sp.solution....
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client....
AMAZON_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1....
AMAZON_LWA_REFRESH_TOKEN=Atzr|....
AMAZON_SP_API_REGION=NA
AMAZON_SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_AWS_REGION=us-east-1

# ASIN dự phòng cho GET /api/amazon/whoami: shop mới chưa có tồn kho FBA thì
# inventory trả 0 SKU, vẫn cần một ASIN bất kỳ để đọc SellerId từ feesEstimate.
# Để trống → dùng mặc định B08N5WRWNW.
AMAZON_WHOAMI_FALLBACK_ASIN=B08N5WRWNW

# ------------------------------------------------------------
# MODULE 0 — OAuth THẬT & MULTI-TENANT (migration 0020)
# ------------------------------------------------------------
# URL gốc của app (để dựng redirect_uri). Trên Vercel có thể bỏ trống — code tự
# lấy VERCEL_PROJECT_PRODUCTION_URL. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# redirect_uri phải KHỚP TUYỆT ĐỐI giá trị đã khai trong app Amazon
# (SP-API: Developer Central → app → OAuth redirect URL; Ads: Security profile).
# Bỏ trống → tự ghép APP_BASE_URL + /api/amazon/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/api/amazon/oauth/callback

# Khoá mã hoá refresh token (AES-256-GCM). KHÔNG có khoá này thì RPC 0020 TỪ CHỐI
# lưu token (fail-closed) — không bao giờ lưu plaintext xuống DB.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LƯU Ý: mất khoá = mất khả năng giải mã token đã lưu (phải nhờ chủ shop authorize lại).
OAUTH_TOKEN_ENC_KEY=64-hex-chars-here

# Khoá HMAC ký `state` chống CSRF + ký link /start gửi chủ shop.
# Bỏ trống thì code dùng lại CRON_SECRET (chạy được, nhưng nên đặt riêng).
OAUTH_STATE_SECRET=choose-another-long-random-string

# Application ID của app SP-API (amzn1.sp.solution.…) — có thì link authorize dùng
# trang consent của Seller Central (đúng luồng Amazon duyệt app production).
AMAZON_SP_API_APPLICATION_ID=amzn1.sp.solution....

# ------------------------------------------------------------
# AMAZON ADS API (Module 5 — PPC). Ads dùng BỘ CREDENTIAL RIÊNG, không dùng chung
# client_id/secret với SP-API: lấy ở advertising.amazon.com → Developer Console →
# Security profile (chọn loại Web app để được cấp refresh_token).
# ------------------------------------------------------------
AMAZON_ADS_CLIENT_ID=amzn1.application-oa2-client....
AMAZON_ADS_CLIENT_SECRET=amzn1.oa2-cs.v1....
# Đã có sẵn refresh token Ads → POST /api/amazon/oauth/import {service:"ads",source:"env"}
# để nạp vào shop, hoặc để worker tự dùng khi shop chưa có token trong DB.
AMAZON_ADS_REFRESH_TOKEN=Atzr|....
# NA | EU | FE — quyết định host Ads API và endpoint LWA
AMAZON_ADS_REGION=NA

# Vercel Cron secret (đặt giống giá trị trong Vercel Project Settings → Environment Variables)
CRON_SECRET=choose-a-long-random-string-here
