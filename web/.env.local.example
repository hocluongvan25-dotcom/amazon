# ============================================================
# File .env.local MẪU — copy thành .env.local và điền giá trị thật.
# KHÔNG commit file .env.local (đã có trong .gitignore).
# File .env.local.example chỉ chứa placeholder, không có secret thật.
# ============================================================

# Site URL — origin thật của production, dùng cho redirect_to khi mời (tránh localhost:3000 lọt vào email)
# Ví dụ: https://ops.vexim.vn
NEXT_PUBLIC_SITE_URL=https://ops.vexim.vn

# Supabase — project ref: pitmyzovjwflkyoqjbkz
NEXT_PUBLIC_SUPABASE_URL=https://pitmyzovjwflkyoqjbkz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ dùng server-side (cron jobs, admin actions), không bao giờ lộ ra client:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Amazon SP-API (lấy từ Seller Central → Partner Network → Developer Central
# → ứng dụng VEXIM Ops → self-authorize cho seller ID của VEXIM)
# LƯU Ý BẢO MẬT: LWA_CLIENT_SECRET và LWA_REFRESH_TOKEN là bí mật — KHÔNG commit,
# không chia sẻ qua chat/email, sau khi hoàn thành testing production cần ROTATE.
AMAZON_APP_ID=amzn1.sp.solution....
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client....
AMAZON_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1....
AMAZON_LWA_REFRESH_TOKEN=Atzr|....
AMAZON_SP_API_REGION=NA
AMAZON_SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_AWS_REGION=us-east-1

# ASIN dự phòng cho GET /api/amazon/whoami: shop mới chưa có tồn kho FBA thì
# inventory trả 0 SKU, vẫn cần một ASIN bất kỳ để đọc SellerId từ feesEstimate.
# Để trống → dùng mặc định B08N5WRWNW.
AMAZON_WHOAMI_FALLBACK_ASIN=B08N5WRWNW

# Vercel Cron secret (đặt giống giá trị trong Vercel Project Settings → Environment Variables)
CRON_SECRET=choose-a-long-random-string-here

# Module 8 — Product Research (G2: Rainforest; G4: LLM). Thiếu key → job chạy
# provider mock, trả 'skipped/demo', không làm đỏ dashboard.
RAINFOREST_API_KEY=
RAINFOREST_WEBHOOK_SECRET=
# URL công khai của app để Rainforest gọi webhook Collections (vd https://ops.vexim.vn)
RAINFOREST_WEBHOOK_BASE_URL=
# openai | anthropic | mock (mặc định mock ở demo) — dùng từ G4
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Ngưỡng cảnh báo chi credits Rainforest/tháng (xem view vexim_research_credit_monthly)
RESEARCH_CREDIT_BUDGET_MONTHLY=2000
